{
  "name": "arknights-name-input",
  "version": "1.0.0",
  "description": "一个可直接嵌入现有网站或小游戏的明日方舟干员名输入框 Web Component",
  "main": "dist/arknights-name-input.js",
  "files": [
    "dist",
    "demo",
    "docs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Decolv/yet-another-arknights-input.git"
  },
  "homepage": "https://github.com/Decolv/yet-another-arknights-input#readme",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "update-data": "tsx scripts/update-data.ts",
    "check-data": "tsx scripts/check-data.ts",
    "demo": "tsx scripts/serve-static.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "csv-parse": "^7.0.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "pinyin-pro": "^3.28.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
